[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Core data
nfl-data-py = ">=0.3.3"
cfbd = ">=1.0.0"
requests = ">=2.31.0"
pandas = "*"
numpy = ">=1.24.0"

# Database
sqlalchemy = ">=2.0.0"

# ML (for models layer — not needed just for data)
lightgbm = ">=4.0.0"
scikit-learn = ">=1.3.0"
shap = ">=0.43.0"

# AI / Agent layer
langchain = ">=0.2.0"
langchain-anthropic = ">=0.1.0"
langchain-chroma = ">=0.1.0"
posthog = ">=2.4.0,<6.0.0"
langgraph = ">=0.1.0"
tavily-python = ">=0.3.0"

# RAG layer (vector store + scraping)
pydantic = "<2.0.0"
rapidfuzz = ">=2.0.0"
langchain-core = ">=0.1.0"
sentence-transformers = ">=2.2.0"
beautifulsoup4 = ">=4.12.0"
playwright = ">=1.40.0"
cloudscraper = ">=1.2.71"

# Streamlit app
streamlit = ">=1.35.0"

[dev-packages]
jupyter = ">=1.0.0"
matplotlib = ">=3.7.0"
seaborn = ">=0.12.0"
mlflow = ">=2.12.0"

[requires]
python_version = "3.11"
